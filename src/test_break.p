DEFINE VARIABLE dPrice      AS DECIMAL   NO-UNDO.
DEFINE VARIABLE cWhy        AS CHARACTER NO-UNDO.
DEFINE VARIABLE dComp       AS DECIMAL   NO-UNDO.
DEFINE VARIABLE cPerk       AS CHARACTER NO-UNDO.
DEFINE VARIABLE dFloor      AS DECIMAL   NO-UNDO.
DEFINE VARIABLE oProposalID AS INTEGER   NO-UNDO.

MESSAGE 'Starting Break-It Tests...' VIEW-AS ALERT-BOX.

RUN fp_price.p (INPUT 9999, INPUT 0, INPUT 420.00, INPUT 300.00, INPUT 50, INPUT 999, INPUT 72, OUTPUT oProposalID, OUTPUT cWhy).
FIND ae_Proposal WHERE ae_Proposal.ProposalID = oProposalID NO-LOCK NO-ERROR.
IF AVAILABLE ae_Proposal THEN dPrice = ae_Proposal.ProposedValue.
ELSE dPrice = 420.00.
MESSAGE 'Test 1 (Ghost): ' + cWhy VIEW-AS ALERT-BOX.

RUN fp_comp_perk.p (INPUT 1, INPUT 9999, INPUT 420.00, INPUT 420.00, INPUT NO, INPUT 'RELEASE', OUTPUT dComp, OUTPUT cPerk).
MESSAGE 'Test 2 (Phantom): Comp=' + STRING(dComp) + ' Perk=' + cPerk VIEW-AS ALERT-BOX.

RUN fp_price.p (INPUT 1, INPUT 0, INPUT 420.00, INPUT 999.00, INPUT 50, INPUT 999, INPUT 72, OUTPUT oProposalID, OUTPUT cWhy).
FIND ae_Proposal WHERE ae_Proposal.ProposalID = oProposalID NO-LOCK NO-ERROR.
IF AVAILABLE ae_Proposal THEN dPrice = ae_Proposal.ProposedValue.
ELSE dPrice = 420.00.
MESSAGE 'Test 3 (High Cost): ' + cWhy VIEW-AS ALERT-BOX.

RUN fp_floor.p (INPUT 500, INPUT 300, INPUT 85, INPUT 50, INPUT -10, INPUT 72, OUTPUT dFloor).
MESSAGE 'Test 4 (Neg Hours): Floor=' + STRING(dFloor) VIEW-AS ALERT-BOX.

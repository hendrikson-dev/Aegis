DEFINE INPUT  PARAMETER dBasePrice    AS DECIMAL NO-UNDO.
DEFINE INPUT  PARAMETER dMarginalCost AS DECIMAL NO-UNDO.
DEFINE INPUT  PARAMETER dSegFloorPct  AS DECIMAL NO-UNDO.
DEFINE INPUT  PARAMETER dOccupancy    AS DECIMAL NO-UNDO.
DEFINE INPUT  PARAMETER dHoursLeft    AS DECIMAL NO-UNDO.
DEFINE INPUT  PARAMETER dWindow       AS DECIMAL NO-UNDO.
DEFINE OUTPUT PARAMETER dFloor        AS DECIMAL NO-UNDO.

DEFINE VARIABLE dMaxDrop AS DECIMAL NO-UNDO INITIAL 0.5.
DEFINE VARIABLE dTimeF   AS DECIMAL NO-UNDO.
DEFINE VARIABLE dUnsoldF AS DECIMAL NO-UNDO.
DEFINE VARIABLE dEffPct  AS DECIMAL NO-UNDO.

dTimeF   = 1 - MINIMUM(MAXIMUM(dHoursLeft, 0), dWindow) / dWindow.
dUnsoldF = 1 - MINIMUM(MAXIMUM(dOccupancy, 0), 100) / 100.
dEffPct  = dSegFloorPct * (1 - dMaxDrop * dTimeF * dUnsoldF).

dFloor = MAXIMUM(ROUND(dBasePrice * dEffPct / 100, 2), dMarginalCost).

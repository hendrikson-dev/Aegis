ADD SEQUENCE "ae_ProposalSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "ae_WarrantSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "ae_ExceptionSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "ae_RegimeSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "ae_LogSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "ae_AssetSeq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD TABLE "ae_AiLog"
  AREA "Schema Area"
  DUMP-NAME "ae_ailog"

ADD FIELD "LogID" OF "ae_AiLog" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "AiPoint" OF "ae_AiLog" AS character 
  FORMAT "x(20)"
  INITIAL "Advocate"
  POSITION 3
  MAX-WIDTH 40
  VALEXP "AiPoint = 'Advocate' OR AiPoint = 'Concierge'"
  VALMSG "Error: AiPoint must be Advocate or Concierge."
  ORDER 20

ADD FIELD "AiResult" OF "ae_AiLog" AS character 
  FORMAT "x(20)"
  INITIAL "failed"
  POSITION 4
  MAX-WIDTH 40
  VALEXP "AiResult = 'accepted' OR AiResult = 'rejected' OR AiResult = 'failed' OR AiResult = 'fallback'"
  VALMSG "Error: AiResult must be accepted, rejected, failed, or fallback."
  ORDER 30

ADD FIELD "Millis" OF "ae_AiLog" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "LoggedAt" OF "ae_AiLog" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 12
  ORDER 50

ADD INDEX "LogID" ON "ae_AiLog" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "LogID" ASCENDING 

ADD TABLE "ae_Asset"
  AREA "Schema Area"
  DUMP-NAME "ae_asset"

ADD FIELD "AssetID" OF "ae_Asset" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "AssetType" OF "ae_Asset" AS character 
  DESCRIPTION "e.g., 'Bus', 'Hotel', 'Salon'"
  FORMAT "x(20)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 40
  ORDER 20

ADD FIELD "AssetName" OF "ae_Asset" AS character 
  DESCRIPTION "e.g., 'Joburg to Durban - 07:00 AM'"
  FORMAT "x(50)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 100
  ORDER 30

ADD FIELD "Capacity" OF "ae_Asset" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "BasePrice" OF "ae_Asset" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "DepartureTime" OF "ae_Asset" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 12
  ORDER 60

ADD FIELD "Schedule" OF "ae_Asset" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 40
  ORDER 70

ADD INDEX "AssetID" ON "ae_Asset" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "AssetID" ASCENDING 

ADD TABLE "ae_Charter"
  AREA "Schema Area"
  DUMP-NAME "ae_charter"

ADD FIELD "ClauseID" OF "ae_Charter" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 2
  MAX-WIDTH 40
  ORDER 10

ADD FIELD "Version" OF "ae_Charter" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "EngineScope" OF "ae_Charter" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 100
  ORDER 30

ADD FIELD "Regime" OF "ae_Charter" AS character 
  FORMAT "x(20)"
  INITIAL "Normal"
  POSITION 5
  MAX-WIDTH 40
  VALEXP "Regime = 'Normal' OR Regime = 'Surge' OR Regime = 'All'"
  VALMSG "Error: Regime must be Normal, Surge, or All."
  ORDER 40

ADD FIELD "RuleText" OF "ae_Charter" AS character 
  FORMAT "x(255)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 510
  ORDER 50

ADD FIELD "Active" OF "ae_Charter" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 7
  MAX-WIDTH 1
  ORDER 60

ADD FIELD "EffectiveFrom" OF "ae_Charter" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 12
  ORDER 70

ADD FIELD "LimitValue" OF "ae_Charter" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 80

ADD INDEX "CharterPk" ON "ae_Charter" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ClauseID" ASCENDING 
  INDEX-FIELD "Version" ASCENDING 

ADD INDEX "VersionIDx" ON "ae_Charter" 
  AREA "Schema Area"
  INDEX-FIELD "Version" ASCENDING 

ADD TABLE "ae_Exception"
  AREA "Schema Area"
  DUMP-NAME "ae_exception"

ADD FIELD "ExceptionID" OF "ae_Exception" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "WarrantID" OF "ae_Exception" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "ExcState" OF "ae_Exception" AS character 
  FORMAT "x(20)"
  INITIAL "Normal"
  POSITION 4
  MAX-WIDTH 40
  VALEXP "ExcState = 'Open' OR ExcState = 'Overridden' OR ExcState = 'Closed'"
  VALMSG "Error: ExcState must be Open, Overridden, or Closed."
  ORDER 30

ADD FIELD "ReasonCode" OF "ae_Exception" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 100
  ORDER 40

ADD FIELD "HandledBy" OF "ae_Exception" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 100
  ORDER 50

ADD FIELD "HandledAt" OF "ae_Exception" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 12
  ORDER 60

ADD INDEX "ExceptionID" ON "ae_Exception" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ExceptionID" ASCENDING 

ADD TABLE "ae_Proposal"
  AREA "Schema Area"
  DUMP-NAME "ae_proposal"

ADD FIELD "ProposalID" OF "ae_Proposal" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "Engine" OF "ae_Proposal" AS character 
  FORMAT "x(50)"
  INITIAL "Strategy"
  POSITION 3
  MAX-WIDTH 100
  VALEXP "Engine = 'Strategy' OR Engine = 'Provision' OR Engine = 'Demand' OR Engine = 'HR'"
  VALMSG "Error: Engine must be Strategy, Provision, Demand, or HR."
  ORDER 20

ADD FIELD "Subject" OF "ae_Proposal" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 100
  ORDER 30

ADD FIELD "Kind" OF "ae_Proposal" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 100
  ORDER 40

ADD FIELD "BaseValue" OF "ae_Proposal" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "ProposedValue" OF "ae_Proposal" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD FIELD "FloorValue" OF "ae_Proposal" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

ADD FIELD "ProposedText" OF "ae_Proposal" AS character 
  FORMAT "x(255)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 510
  ORDER 80

ADD FIELD "TextSource" OF "ae_Proposal" AS character 
  FORMAT "x(20)"
  INITIAL "MOCK"
  POSITION 10
  MAX-WIDTH 40
  VALEXP "TextSource = 'AI' OR TextSource = 'MOCK' OR TextSource = 'TEMPLATE'"
  VALMSG "Error: TextSource must be AI, MOCK, or TEMPLATE."
  ORDER 90

ADD FIELD "CreatedAt" OF "ae_Proposal" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 12
  ORDER 100

ADD FIELD "AssetID" OF "ae_Proposal" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 4
  ORDER 110

ADD INDEX "ProposalID" ON "ae_Proposal" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ProposalID" ASCENDING 

ADD INDEX "AssetID" ON "ae_Proposal" 
  AREA "Schema Area"
  INDEX-FIELD "AssetID" ASCENDING 


ADD TABLE "ae_Warrant"
  AREA "Schema Area"
  DUMP-NAME "ae_warrant"

ADD FIELD "WarrantID" OF "ae_Warrant" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "ProposalID" OF "ae_Warrant" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "CharterVersion" OF "ae_Warrant" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "Regime" OF "ae_Warrant" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 40
  ORDER 40

ADD FIELD "Clauses" OF "ae_Warrant" AS character 
  FORMAT "x(100)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 200
  ORDER 50

ADD FIELD "Ruling" OF "ae_Warrant" AS character 
  FORMAT "x(20)"
  INITIAL "Deny"
  POSITION 7
  MAX-WIDTH 40
  VALEXP "Ruling = 'Admit' OR Ruling = 'Deny' OR Ruling = 'Override'"
  VALMSG "Error: Ruling must be Admit, Deny, or Override."
  ORDER 60

ADD FIELD "ReasonCode" OF "ae_Warrant" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 100
  ORDER 70

ADD FIELD "Authorizer" OF "ae_Warrant" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 100
  ORDER 80

ADD FIELD "CustNum" OF "ae_Warrant" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 10
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "SealedAt" OF "ae_Warrant" AS datetime-tz 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 12
  ORDER 100

ADD FIELD "PrevFingerprint" OF "ae_Warrant" AS character 
  FORMAT "x(255)"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 510
  ORDER 110

ADD INDEX "WarrantID" ON "ae_Warrant" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "WarrantID" ASCENDING 

